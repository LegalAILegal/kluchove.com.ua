# Copy to backend/.env and fill in. NEVER commit the real .env (it is gitignored).

# --- Kyivstar OAuth2 ---
KS_TOKEN_URL=https://api-gateway.kyivstar.ua/idp/oauth2/token
KS_CLIENT_ID=
KS_CLIENT_SECRET=

# --- Kyivstar SMS OTP Verification ---
# Mock:  https://api-gateway.kyivstar.ua/mock/rest/v1
# Prod:  https://api-gateway.kyivstar.ua/rest/v1   (confirm exact prod base)
KS_API_BASE=https://api-gateway.kyivstar.ua/mock/rest/v1
KS_TEMPLATE_ID=1
KS_VERIFY_PATH=/verification/sms/check
KS_VERIFY_SUBSCRIBER_FIELD=subscriberId
KS_VERIFY_CODE_FIELD=validationCode

# --- Telegram Gateway (second OTP channel; leave token empty to use SMS only) ---
# Access token from https://gateway.telegram.org (top up TON for live sends;
# codes to your own number are free to test).
TG_GATEWAY_TOKEN=
TG_GATEWAY_BASE=https://gatewayapi.telegram.org
TG_CODE_LENGTH=6

# --- Google Sheets (private, service account) ---
SHEET_ID=1HqqepslB5VUAm24cpubUDtt015DqQsmXy6YoXEKMCIU
SHEET_RANGE=A2:N
GOOGLE_CREDENTIALS_FILE=/run/secrets/google_sa.json

# --- Session / security ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_SECONDS=900
CHALLENGE_TTL_SECONDS=300
MAX_CODE_ATTEMPTS=5

# --- Rate limiting ---
RL_MAX_REQUESTS_PER_PHONE=3
RL_MAX_REQUESTS_PER_IP=10
RL_WINDOW_SECONDS=3600

CORS_ORIGINS=
